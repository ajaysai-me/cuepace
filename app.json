{
  "expo": {
    "name": "CuePace",
    "slug": "cuepace",
    "scheme": "cuepace",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cuepace.app"
    },
    "android": {
      "package": "com.cuepace.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFD500",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "CuePace uses the camera to record you while you read your script.",
          "microphonePermission": "CuePace uses the microphone to record audio with your video.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "CuePace saves your recorded videos to your photo library.",
          "granularPermissions": [
            "video"
          ]
        }
      ],
      "expo-font",
      "expo-video",
      "expo-image",
      "./plugins/with-release-signing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#FFD500"
        }
      ]
    ]
  }
}
